<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="AliceBlue">
    <VerticalStackLayout VerticalOptions="Center" Padding="10">
        <Label 
            Text="Calculo da Diária" FontFamily="GoogleSans" FontSize="53"
            TextColor="Black"/>

        <Border Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*,Auto">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:"
                           TextColor="Black"/>
                       

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="Aqua"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"
                           />

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="Black"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:"
                           TextColor="Black"/>
                    
                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="Aqua"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"
                           />

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="Black"/>



                </Grid>
                <Label Text="Escolha sua Suíte"
                       TextColor="Black"></Label>
                <Picker x:Name="pick_quarto"
                        Title="Selecione sua Acomodação"
                        TextColor="Black"
                        />
                        
                <Border>
                    <VerticalStackLayout>
                        <Label Text="Período de estadia" TextColor="Black"/>
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" TextColor="Black"/>
                            <DatePicker x:Name="dtpck_checkin"
                                       Format="dd/mm/yyyy" TextColor="Black"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="Check-out:" TextColor="Black"/>
                            <DatePicker x:Name="dtpck_checkout"
               Format="dd/mm/yyyy" TextColor="Black"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Avançar" Background="Aqua"></Button>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>